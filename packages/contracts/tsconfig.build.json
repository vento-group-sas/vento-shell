{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "incremental": false,
    "composite": false,
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": [
    "**/generated/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
