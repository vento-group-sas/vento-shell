  "requirements": [
    {
      "id": "TREQ-SUPABASE-029",
      "oracle": "Auth remains a managed authentication boundary; identity_access links to technical Auth subjects without creating foreign keys into managed Auth internals.",
      "scenarios": [
        "active_employee"
      ]
    },
    {
      "id": "TREQ-SUPABASE-116",
      "oracle": "Authenticator remains NOINHERIT and can SET the expected API roles without accumulating their privileges.",
      "scenarios": [
        "active_employee"
      ]
    },
    {
      "id": "TREQ-SUPABASE-117",
      "oracle": "service_role remains backend-only and receives no direct schema/table access to identity_access.",
      "scenarios": [
        "active_service"
      ]
    },
    {
      "id": "TREQ-SUPABASE-124",
      "oracle": "Auth account identity is a replaceable technical credential reference and never the enterprise identity itself.",
      "scenarios": [
        "active_employee",
        "active_customer"
      ]
    },
    {
      "id": "TREQ-SUPABASE-125",
      "oracle": "A technical Auth subject may be linked through explicit governed identity kinds; ambiguous resolution fails closed instead of imposing an accidental global one-to-one identity rule.",
      "scenarios": [
        "multi_kind_requires_kind",
        "ambiguous_same_kind"
      ]
    },
    {
      "id": "TREQ-SUPABASE-126",
      "oracle": "Session/AAL observations do not activate or revive enterprise identity links; inactive links remain denied.",
      "scenarios": [
        "revoked_with_session"
      ]
    },
    {
      "id": "TREQ-SUPABASE-127",
      "oracle": "An inactive/suspended workforce identity cannot resolve to an active enterprise context.",
      "scenarios": [
        "suspended_employee"
      ]
    },
    {
      "id": "TREQ-SUPABASE-131",
      "oracle": "An active HUMAN_USER to EMPLOYEE link resolves an employee identity without deriving site, area or permission from Auth metadata.",
      "scenarios": [
        "active_employee"
      ]
    },
    {
      "id": "TREQ-SUPABASE-134",
      "oracle": "A STAFF_INVITATION origin is accepted only as an explicit governed HUMAN_USER to EMPLOYEE link; client metadata cannot replace it.",
      "scenarios": [
        "invitation_employee"
      ]
    },
    {
      "id": "TREQ-SUPABASE-135",
      "oracle": "Subject class is explicit: HUMAN_USER, SHARED_DEVICE and SERVICE map only to their approved enterprise identity kinds.",
      "scenarios": [
        "active_employee",
        "active_device",
        "active_service"
      ]
    },
    {
      "id": "TREQ-SUPABASE-138",
      "oracle": "Historical inventory counts remain evidence/baseline only and never become authorization or automatic backfill.",
      "scenarios": [
        "baseline_not_authority"
      ]
    }
  ],
