{
  "schema_version": 1,
  "policy_id": "CANONICAL-IMPLEMENTATION-CONTROL-001",
  "authorization_mode": "EXPLICIT_PER_PHASE",
  "automatic_authorization": false,
  "single_primary_action": false,
  "execution_operator_policy": {
    "default_operator": "HUMAN_USER",
    "interaction_mode": "CONTINUOUS_BATCH_UNTIL_EVIDENCE_GATE",
    "assistant_repository_writes": true,
    "assistant_validation_execution": true,
    "assistant_git_operations": true,
    "assistant_remote_mutations": false,
    "assistant_pull_request_operations": {
      "create": true,
      "update_title_body": true,
      "read_checks": true,
      "require_approved_scope": true,
      "require_published_branch": true,
      "push": "PHASE_APPROVED_SCOPE",
      "merge": "APPROVAL_REQUIRED_PER_ACTION",
      "auto_merge": false,
      "deploy": "APPROVAL_REQUIRED_PER_ACTION",
      "remote_code_edits": false
    },
    "assistant_read_only_audit": true,
    "pause_only_when_next_step_depends_on_evidence": true,
    "evidence_reply_prefix": "RESULTADO DEL PASO ",
    "assisted_execution_authorization_prefix": "AUTORIZO EJECUCION ASISTIDA DEL PASO "
  },
  "instance_storage_mode": "ONE_FILE_PER_INSTANCE",
  "instance_records_directory": "docs/plan-canonico/modular/implementation-instances",
  "instance_history_mode": "APPEND_ONLY_LEDGER",
  "verified_instances_immutable": true,
  "instance_statuses": [
    "PENDING_AUTHORIZATION",
    "AUTHORIZED",
    "IN_PROGRESS",
    "BLOCKED",
    "IMPLEMENTED",
    "VERIFIED",
    "DEFERRED"
  ],
  "authorization_entrypoint": "docs:implementation:authorize",
  "phase_execution": {
    "mode": "APPROVED_PACKAGE_PHASE",
    "approval_granularity": "ONCE_PER_PACKAGE_PHASE",
    "phase_source": "APPROVED_PACKAGE_GATE",
    "in_phase_operations": [
      "EDIT_APPROVED_SCOPE",
      "RUN_VALIDATIONS",
      "FIX_DEFECTS",
      "LOCAL_COMMIT",
      "PUSH_APPROVED_BRANCH",
      "CREATE_OR_UPDATE_PR"
    ],
    "independent_decisions": [
      "EXPAND_SCOPE",
      "MERGE",
      "DEPLOY",
      "PUBLISH_PACKAGE",
      "REMOTE_DATABASE_MUTATION",
      "CHANGE_CREDENTIALS"
    ],
    "checkpoint_policy": "PHASE_ENTRY_RISK_BOUNDARY_AND_CLOSE",
    "evidence_policy": "FRESH_CANDIDATE_AND_PRESERVED_HISTORY"
  }
}
